# Excluded from the zip .github/workflows/release.yml builds via
# `git archive` — dev-only tooling that a site running the plugin doesn't
# need, kept out to match how e.g. WordPress.org SVN deploys trim a repo
# down to its distributable contents.
/.github export-ignore
/.vscode export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.json export-ignore
/composer.lock export-ignore

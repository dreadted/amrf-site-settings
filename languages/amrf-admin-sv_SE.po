#: includes/ContactForm/Provider.php:65
msgid "Contact Forms"
msgstr "Kontaktformulär"

#: includes/ContactForm/Provider.php:95
msgid "Default Contact Form"
msgstr "Standardkontaktformulär"

#: includes/ContactForm/Provider.php:102
msgid "Apply Consistent Contact Form Styling"
msgstr "Tillämpa enhetlig formulärstil"

#: includes/ContactForm/Provider.php:117
msgid "GDPR"
msgstr "GDPR"

#: includes/ContactForm/Provider.php:121
msgid "Contact Forms Subject to Retention"
msgstr "Formulär som omfattas av rensningen"

#: includes/ContactForm/Provider.php:128
msgid "Delete submissions after this many days"
msgstr "Radera inskickade formulär efter så här många dagar"

#: includes/ContactForm/Provider.php:160
#: includes/ContactForm/Provider.php:238
msgid "No FluentForm forms found."
msgstr "Inga FluentForm-formulär hittades."

#: includes/ContactForm/Provider.php:174
msgid "The form the sitewide \"#kontakt\" link/button opens in a lightbox."
msgstr "Formuläret som sajtens länkar/knappar mot ankaret \"#kontakt\" öppnar i en lightbox."

#: includes/ContactForm/Provider.php:190
msgid "Maps FluentForm's own color/border-radius variables to this site's theme colors and applies additional styling fixes, on every FluentForm on the site."
msgstr "Kopplar FluentForms egna färg-/hörnradievariabler till sajtens temafärger och tillämpar ytterligare stiljusteringar, på samtliga FluentForm-formulär på sajten."

#: includes/ContactForm/Provider.php:253
msgid "The daily retention cleanup and personal-data export/erase requests only ever touch these forms."
msgstr "Den dagliga rensningen och begäranden om export/radering av personuppgifter rör bara dessa formulär."

#: includes/ContactForm/Provider.php:271
msgid "Blank or 0 = keep forever."
msgstr "Tomt eller 0 = spara för alltid."

#: includes/FluentFormValidation/Provider.php:72
msgid "Please enter a valid Swedish Personal Identity Number (YYMMDD-XXXX)."
msgstr "Ange ett giltigt svenskt personnummer (ÅÅMMDD-XXXX)."

#: includes/Hardening/Provider.php:65
msgid "There is an error."
msgstr "Ett fel har uppstått."

#: includes/Hardening/Provider.php:180
#: includes/Hardening/Provider.php:181
msgid "Hardening"
msgstr "Härdning"

#: includes/Hardening/Provider.php:211
msgid "Disable author archives"
msgstr "Inaktivera författararkiv"

#: includes/Hardening/Provider.php:212
msgid "Redirects author archive pages to the homepage — mainly useful on single-author sites, or to avoid leaking usernames via author URLs."
msgstr "Omdirigerar författararkivsidor till startsidan — användbart på sajter med en enda författare, eller för att undvika att användarnamn läcker via författar-URL:er."

#: includes/Hardening/Provider.php:215
msgid "Redirect 404 pages to the homepage"
msgstr "Omdirigera 404-sidor till startsidan"

#: includes/Hardening/Provider.php:216
msgid "Applies to logged-out visitors only. Turn off if this site should show a real 404 page instead."
msgstr "Gäller bara utloggade besökare. Stäng av om sajten istället ska visa en riktig 404-sida."

#: includes/Hardening/Provider.php:219
msgid "Remove jQuery Migrate"
msgstr "Ta bort jQuery Migrate"

#: includes/Hardening/Provider.php:220
msgid "Turn off if an older plugin or theme on this site depends on jQuery Migrate's compatibility shims."
msgstr "Stäng av om ett äldre plugin eller tema på sajten är beroende av jQuery Migrates kompatibilitetslager."

#: includes/Hardening/Provider.php:223
msgid "Disable generated image sizes"
msgstr "Inaktivera genererade bildstorlekar"

#: includes/Hardening/Provider.php:224
msgid "Stops WordPress from generating additional (responsive) image sizes and auto-scaling large uploads. Turn off if this site relies on WordPress's own generated image sizes."
msgstr "Hindrar WordPress från att generera ytterligare (responsiva) bildstorlekar och automatiskt skala stora uppladdningar. Stäng av om sajten är beroende av WordPress egna genererade bildstorlekar."


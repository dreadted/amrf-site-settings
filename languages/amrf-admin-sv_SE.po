#, php-format
msgid "ERROR: Password must be at least %d characters long."
msgstr "FEL: Lösenordet måste vara minst %d tecken långt."

#: amrf-admin-settings.php:844
msgid "Page Editor"
msgstr "Redigera sida"

#: amrf-admin-settings.php:430
msgid "Login Redirect"
msgstr "Vidarebefordring efter inloggning"

#: amrf-admin-settings.php:445
msgid "Default Admin Page"
msgstr "Standardsida för admin"


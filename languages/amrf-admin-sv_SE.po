#. Plugin Name of the plugin
#: amrf-admin.php includes/Admin/SettingsPage.php:47
#: includes/Admin/SettingsPage.php:48 includes/Hooks/AdminHooks.php:98
#: includes/Utilities/SettingsRenderer.php:39
msgid "Admin Panel Settings"
msgstr "Inställningar för Adminpanelen"

#. Description of the plugin
#: amrf-admin.php
msgid "Customize admin panel settings for different user roles."
msgstr "Ange panelinställningar för respektive användarroll."

#: includes/Hooks/AdminHooks.php:79
msgid "Settings"
msgstr "Inställningar"

#: includes/Hooks/FrontendHooks.php:159
msgid "Page Editor"
msgstr "Redigera sida"

#. translators: %d is the number indicating minimum password length
#: includes/Hooks/FrontendHooks.php:210 includes/Hooks/FrontendHooks.php:242
#, php-format
msgid "ERROR: Password must be at least %d characters long."
msgstr "FEL: Lösenordet måste bestå av minst %d tecken."

#: includes/Settings/Manager.php:50
msgid "General Settings"
msgstr "Allmänna inställningar"

#: includes/Settings/Manager.php:56
msgid "Add Page Editor Link"
msgstr "Lägg till \"Redigera sida\" i menyn"

#: includes/Settings/Manager.php:63
msgid "Minimum Password Length"
msgstr "Minsta tillåtna antal tecken i lösenord"

#: includes/Settings/Manager.php:70
msgid "Prevent Non-Admins from Changing Passwords"
msgstr "Förhindra att icke-administratörer byter lösenord"

#: includes/Settings/Manager.php:77
msgid "Hide Application Passwords for Non-Admins"
msgstr "Dölj applikationslösenord för icke-administratörer"

#: includes/Settings/Manager.php:84
msgid "Remove Admin Bar Items for Non-Admins"
msgstr "Ta bort länkar från administrationsfältet för icke-administratörer"

#: includes/Settings/Manager.php:91
msgid "Remove Default Dashboard Widgets"
msgstr "Ta bort standardwidgetar från adminpanelen"

#: includes/Settings/Manager.php:103 includes/Settings/Manager.php:109
#, php-format
msgid "%s Settings"
msgstr "Inställningar för %s"

#: includes/Settings/Manager.php:180
msgid "Configure general admin panel settings."
msgstr "Ange allmänna inställningar för adminpanelen."

#: includes/Settings/Manager.php:190
msgid "Configure settings for each user role."
msgstr "Ange inställningar för respektive användarroll."

#: includes/Settings/Manager.php:219
msgid "Minimum required characters for user passwords."
msgstr "Minsta antal tillåtna tecken för användarnas lösenord."

#: includes/Settings/Manager.php:281
msgid "Login Redirect"
msgstr "Omdirigering efter inloggning"

#: includes/Settings/Manager.php:284
msgid "-- Select Redirect URL --"
msgstr "-- Välj sida för omdirigering --"

#: includes/Settings/Manager.php:285
msgid "-- Front Page --"
msgstr "-- Startsida --"

#: includes/Settings/Manager.php:290
msgid "URL to redirect this user role to after login."
msgstr "Sida som skall visas för denna användarroll efter inloggning."

#: includes/Settings/Manager.php:293
msgid "Default Admin Page"
msgstr "Startsida för adminpanelen"

#: includes/Settings/Manager.php:298
msgid "-- Select Default Page --"
msgstr "-- Välj startsida --"

#: includes/Settings/Manager.php:303
msgid "Default page this user role sees when accessing /wp-admin/ (must be one of the allowed menu items below)."
msgstr "Sida som visas när den här användarrollen besöker /wp-admin/ (måste finnas med bland tillåtna menyalternativ)."

#: includes/Settings/Manager.php:306
msgid "Rank Math Access"
msgstr "Tillgång till Rank Math"

#: includes/Settings/Manager.php:311
msgid "Site Menus Access"
msgstr "Tillgång till Menyer"

#: includes/Settings/Manager.php:316
msgid "Allowed Menu Items"
msgstr "Tillåtna menyalternativ"

#: includes/Settings/Manager.php:328
msgid "Select which admin menu items should be visible to this user role."
msgstr "Välj vilka menyalternativ som ska visas i administratörsmenyn för den här användarrollen."

#: includes/Utilities/SettingsRenderer.php:30
msgid "General"
msgstr "Allmänna"

#: includes/Settings/Manager.php:230
msgid "Prevents non-admin users from changing their passwords."
msgstr "Tar bort möjligheten att byta lösenord för icke-administratörer."

#: includes/Settings/Manager.php:240
msgid "Hides application passwords section for non-admin users."
msgstr "Döljer applikationslösenord för icke-administratörer."

#: includes/Settings/Manager.php:250
msgid "Removes comments and new content links from admin bar for non-admins."
msgstr "Tar bort länkar till kommentarer och nytt innehåll från administrationsfältet för icke-administratörer."

#: includes/Settings/Manager.php:260
msgid "Removes default dashboard widgets (Activity, Quick Draft, etc.)."
msgstr "Tar bort standardwidgetar (Aktivitet, Snabbutkast etc.)"

#: includes/Settings/Manager.php:307
msgid "When enabled, this role will have access to all Rank Math features."
msgstr "Ge denna roll tillgång till alla funktioner i Rank Math."

#: includes/Settings/Manager.php:312
msgid "Enable to allow this user role to access and edit site menus."
msgstr "Ge denna roll tillgång till att redigera sajtens menyer."

#: includes/Settings/Manager.php:202
msgid "Adds a link to the front page editor in the admin menu."
msgstr "Lägger till länken \"Redigera sida\" i administratörsmenyn."

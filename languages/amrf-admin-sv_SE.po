msgid "Default page this user role sees when accessing /wp-admin/ (must be one of the allowed menu items below)."
msgstr "Sida som visas när den här användarrollen besöker /wp-admin/ (måste finnas med bland tillåtna menyalternativ)."

#: includes/Settings/Manager.php:459
msgid "Site Menus Access"
msgstr "Tillgång till Menyer"

#: includes/Settings/Manager.php:464
msgid "Allowed Menu Items"
msgstr "Tillåtna menyalternativ"

#: includes/Settings/Manager.php:476
msgid "Select which admin menu items should be visible to this user role."
msgstr "Välj vilka menyalternativ som ska visas i administratörsmenyn för den här användarrollen."

#: includes/Settings/Manager.php:67
msgid "General"
msgstr "Allmänna"

#: includes/Settings/Manager.php:383
msgid "Prevents non-admin users from changing their passwords."
msgstr "Tar bort möjligheten att byta lösenord för icke-administratörer."

#: includes/Settings/Manager.php:393
msgid "Hides application passwords section for non-admin users."
msgstr "Döljer applikationslösenord för icke-administratörer."

#: includes/Settings/Manager.php:403
msgid "Removes comments and new content links from admin bar for non-admins."
msgstr "Tar bort länkar till kommentarer och nytt innehåll från administrationsfältet för icke-administratörer."

#: includes/Settings/Manager.php:413
msgid "Removes default dashboard widgets (Activity, Quick Draft, etc.)."
msgstr "Tar bort standardwidgetar (Aktivitet, Snabbutkast etc.)"

#: includes/Settings/Manager.php:460
msgid "Enable to allow this user role to access and edit site menus."
msgstr "Ge denna roll tillgång till att redigera sajtens menyer."

#: includes/Settings/Manager.php:333
msgid "Adds a link to the front page editor in the admin menu."
msgstr "Lägger till länken \"Redigera sida\" i administratörsmenyn."


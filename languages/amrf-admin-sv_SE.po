#: amrf-admin-settings.php
msgid "Customize admin panel settings for different user roles."
msgstr "Ange panelinställningar för respektive användarroll."

#. Author of the plugin
#: amrf-admin-settings.php
msgid "Christofer Laurin"
msgstr ""


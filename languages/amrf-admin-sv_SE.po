#. Description of the plugin
#: amrf-site-settings.php
msgid "General site settings — SEO, contact forms with GDPR tools, Swish payments, analytics, security hardening, and per-role admin panel control."
msgstr ""

#: includes/Hardening/Uploads.php:133
msgid "You are not allowed to upload SVG files."
msgstr "Du har inte behörighet att ladda upp SVG-filer."

#: includes/Hardening/Uploads.php:140
msgid "This file does not look like a valid SVG."
msgstr "Den här filen verkar inte vara en giltig SVG."

#: includes/Hardening/Uploads.php:147
msgid "This SVG could not be sanitized and was rejected."
msgstr "Den här SVG-filen kunde inte saneras och avvisades."

#: includes/Hardening/SettingsPage.php:119
msgid "Allow SVG uploads"
msgstr "Tillåt SVG-uppladdning"

#: includes/Hardening/SettingsPage.php:120
msgid "Lets administrators upload SVG files through the Media Library — every file is sanitized (scripts, event handlers, and embedded HTML stripped) before it's stored."
msgstr "Låter administratörer ladda upp SVG-filer via Mediabiblioteket — varje fil saneras (skript, händelsehanterare och inbäddad HTML tas bort) innan den sparas."

#: includes/ContactForm/Provider.php:100
msgid "Apply Recommended FluentForm Settings"
msgstr "Tillämpa rekommenderade FluentForm-inställningar"

#: includes/ContactForm/Provider.php:229
msgid "FluentForm is not active."
msgstr "FluentForm är inte aktivt."

#: includes/ContactForm/Provider.php:165
msgid "None"
msgstr "Ingen"

#: includes/Hardening/SettingsPage.php:179
msgid "Disable site search"
msgstr "Stäng av sajtsökning"

#: includes/Hardening/SettingsPage.php:180
msgid "Turns the built-in WordPress search into a 404 for every visitor — useful while a site is still under construction and shouldn't expose a working search box yet."
msgstr "Gör att WordPress inbyggda sökfunktion visar en 404-sida för alla besökare — användbart medan en sajt fortfarande byggs och inte ska visa en fungerande sökruta än."

#. translators: %d is the existing attachment's post ID.
#: includes/Hardening/Uploads.php:193
#, php-format
msgid "This image is identical to an existing upload (attachment #%d) and was not saved again."
msgstr "Den här bilden är identisk med en befintlig uppladdning (bifogad fil #%d) och sparades inte igen."

#: includes/Hardening/SettingsPage.php:57
msgid "Images"
msgstr "Bilder"

#: includes/Hardening/SettingsPage.php:65
msgid "Frontend"
msgstr "Frontend"

#: includes/Settings/Manager.php:574
msgid "SEO Framework Access"
msgstr "Åtkomst till SEO Framework"

#: includes/Settings/Manager.php:575
msgid "Enable to give this user role access to The SEO Framework's meta box on posts/pages and its SEO column in the post/page list."
msgstr "Aktivera för att ge den här användarrollen åtkomst till The SEO Frameworks metabox på inlägg/sidor samt SEO-kolumnen i inläggs-/sidlistan."

#: includes/Hardening/SettingsPage.php:115
msgid "Restrict media deletion"
msgstr "Begränsa borttagning av media"

#: includes/Hardening/SettingsPage.php:116
msgid "Non-administrators can only delete media library items they uploaded themselves. Without this, WordPress lets anyone who can upload files delete any attachment, regardless of who uploaded it."
msgstr "Icke-administratörer kan bara ta bort mediefiler de själva har laddat upp. Utan detta låter WordPress alla som kan ladda upp filer ta bort vilken bilaga som helst, oavsett vem som laddade upp den."

#: includes/ContactForm/Provider.php:175
msgid "The form the sitewide \"#contact\" link/button opens in a lightbox, on any page the active theme doesn't choose one for itself. \"None\" disables the lightbox on pages without such a choice."
msgstr "Formuläret som sajtens länkar/knappar mot ankaret \"#contact\" öppnar i en lightbox, på sidor där det aktiva temat inte väljer ett eget. \"Ingen\" stänger av lightboxen på sidor utan ett sådant val."

#. Plugin Name of the plugin
#: amrf-site-settings.php
msgid "AMRF Site Settings"
msgstr ""

#: includes/Umami/Provider.php:119
msgid "Umami Server"
msgstr "Umami-server"

#: includes/Umami/Provider.php:155
msgid "Umami Cloud (eu.umami.is)"
msgstr "Umami Cloud (eu.umami.is)"

#: includes/Umami/Provider.php:140
msgid "Button Selectors"
msgstr "Knapp-selektorer"

#: includes/Umami/Provider.php:200
msgid "One CSS selector per line. Matched elements are tracked automatically, named after their own visible text. Leave empty to use the built-in defaults."
msgstr "En CSS-selector per rad. Matchande element spåras automatiskt och namnges efter sin egen synliga text. Lämna tomt för att använda standardlistan."

#: includes/Hardening/SettingsPage.php:149
msgid "Restrict site to logged-in users"
msgstr "Begränsa sajten till inloggade användare"

#: includes/Hardening/SettingsPage.php:153
msgid "Blocks every front-end page for logged-out visitors with a blank placeholder page — the WordPress admin and login screen stay reachable. Use this to preview a site privately before launch."
msgstr "Blockerar alla sidor på frontend för utloggade besökare med en tom platshållarsida — WordPress adminpanel och inloggningssida förblir nåbara. Använd detta för att förhandsgranska en sajt privat inför lansering."

#: includes/Hardening/SettingsPage.php:92
msgid "Convert uploads to WebP"
msgstr "Konvertera uppladdningar till WebP"

#: includes/Hardening/SettingsPage.php:96
msgid "Automatically converts every non-WebP image upload to WebP at the quality below, and blocks exact duplicates of an already-uploaded image."
msgstr "Konverterar automatiskt varje uppladdad bild som inte redan är WebP till WebP med kvaliteten nedan, och blockerar exakta dubbletter av en redan uppladdad bild."

#: includes/Hardening/SettingsPage.php:105
msgid "WebP quality"
msgstr "WebP-kvalitet"

#: includes/Hardening/SettingsPage.php:124
msgid "Stops WordPress from generating its own default image sizes (thumbnail, medium, medium_large, large, 1536x1536, 2048x2048). Sizes a theme registers itself are unaffected."
msgstr "Hindrar WordPress från att generera sina egna standardbildstorlekar (thumbnail, medium, medium_large, large, 1536x1536, 2048x2048). Storlekar som ett tema registrerar själv påverkas inte."

#: includes/Hardening/SettingsPage.php:242
msgid "Applies to both the WebP format conversion above and every automatically generated responsive image size (1–100)."
msgstr "Gäller både WebP-konverteringen ovan och varje automatiskt genererad responsiv bildstorlek (1–100)."

#: includes/Hardening/SettingsPage.php:167
msgid "Disable blog posts"
msgstr "Inaktivera blogginlägg"

#: includes/Hardening/SettingsPage.php:168
msgid "For sites built from pages only. Posts, category, tag and date archives, and the RSS feeds return a 404 (then redirect to the homepage if \"Redirect 404 pages to the homepage\" is on), and posts are left out of the WordPress sitemap. Existing posts and the admin are unaffected."
msgstr "För sajter som bara består av sidor. Inlägg, kategori-, tagg- och datumarkiv samt RSS-flöden ger 404 (och omdirigeras sedan till startsidan om \"Omdirigera 404-sidor till startsidan\" är på), och inlägg utesluts ur WordPress sitemap. Befintliga inlägg och adminpanelen påverkas inte."

#: includes/Hardening/SettingsPage.php:171
msgid "Disable comments"
msgstr "Inaktivera kommentarer"

#: includes/Hardening/SettingsPage.php:172
msgid "Closes comments, pingbacks and trackbacks on all content regardless of each page's discussion settings, hides already approved comments, and turns the comment feeds into a 404."
msgstr "Stänger kommentarer, pingbacks och trackbacks på allt innehåll oavsett sidornas diskussionsinställningar, döljer redan godkända kommentarer och gör kommentarsflödena till 404."

#: includes/FluentCrm/ConsentLog.php:62
msgid "Newsletter consent"
msgstr "Samtycke till nyhetsbrev"

#. translators: 1: form title, 2: page URL, 3: IP address, 4: opt-in checkbox label
#: includes/FluentCrm/ConsentLog.php:117
